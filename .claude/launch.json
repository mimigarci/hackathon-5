{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app-web",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8765", "--directory", "app/build/web"],
      "port": 8765
    },
    {
      "name": "wisi-worker",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd worker && npx wrangler dev --port 8787 --local-upstream localhost:8787"],
      "port": 8787
    },
    {
      "name": "wisi-gateway",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && .venv/bin/uvicorn app.main:app --port 8001 --reload"],
      "port": 8001
    }
  ]
}
