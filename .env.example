# Copia este archivo a .env y rellena los valores. NUNCA subas .env al repo.

# --- Gateway WisiVoz (backend/) ---
# mock = ledger simulado en memoria (por defecto). proxy = backend real (no incluido).
WISIVOZ_MODE=mock
# Secreto HMAC que firma los tokens de sesion efimeros del cliente.
WISIVOZ_SESSION_SECRET=cambia-esto-en-produccion
# Secreto compartido que ElevenLabs envia en cada webhook tool.
WISIVOZ_TOOL_SECRET=cambia-esto-tambien
# Vigencia de una intencion de pago/transferencia, en segundos.
WISIVOZ_INTENT_TTL=180

# --- ElevenLabs Conversational AI (voz de Wisi) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Voz a usar para Wisi (voice_id del dashboard de ElevenLabs).
ELEVENLABS_VOICE_ID=

# --- Consola web (web/) ---
# URL publica del gateway que usa la consola React.
VITE_GATEWAY_URL=http://localhost:8000
