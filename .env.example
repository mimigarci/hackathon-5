# Copia este archivo a .env y rellena los valores. NUNCA subas .env al repo.

# --- Gateway WisiVoz (backend/) ---
# mock = ledger simulado en memoria (por defecto). proxy = backend real (no incluido).
WISIVOZ_MODE=mock
# Secreto HMAC que firma los tokens de sesion efimeros del cliente.
WISIVOZ_SESSION_SECRET=cambia-esto-en-produccion
# Secreto compartido que ElevenLabs envia en cada webhook tool.
WISIVOZ_TOOL_SECRET=cambia-esto-tambien
# Vigencia de una intencion de pago/transferencia, en segundos.
WISIVOZ_INTENT_TTL=180
# Maximo de sesiones de voz (signed URLs) por IP cada 10 min (protege creditos).
WISIVOZ_SIGNED_PER_IP_10MIN=30

# --- ElevenLabs Conversational AI (voz de Wisi) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Agentes por voz (los crea agent/provision_client_tools.py).
ELEVENLABS_AGENT_ID_FEMALE=
ELEVENLABS_AGENT_ID_MALE=
# Voz a usar para Wisi (voice_id del dashboard de ElevenLabs).
ELEVENLABS_VOICE_ID=

# --- Consola web (web/) ---
# URL publica del gateway que usa la consola React.
VITE_GATEWAY_URL=http://localhost:8000

# --- Cloudflare (botflow.lat, ver docs/05-despliegue-cloudflare.md) ---
# Token con acceso a Workers sobre la zona botflow.lat (wrangler deploy).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Solo opcion B (tunel a servidor propio): lo escribe deploy/cloudflare_setup.py.
CLOUDFLARE_TUNNEL_TOKEN=
# R2 (almacenamiento S3 de Cloudflare), opcional.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=
